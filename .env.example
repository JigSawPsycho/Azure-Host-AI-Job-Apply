# Copy to .env and fill in. Loaded by main.py via python-dotenv.

# Required: random URL-safe string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Required: Fernet key (urlsafe-base64, 32 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_MASTER_KEY=

# Optional: where to write the local-dev secret store sidecar
SECRETS_LOCAL_PATH=data/secrets.json

# --- GitHub OAuth ---
# Register at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# --- Google OAuth (optional — leave blank if you only want GitHub sign-in) ---
# Register at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/auth/google/callback
# Required scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Email/password ---
# Wired by you. The /auth/email/login and /auth/email/signup endpoints
# return 501 by default — connect them to your IdP (Azure AD B2C / Entra
# External ID / etc.) in api/email_auth.py.

# Optional. Defaults to a local SQLite file under ./data/.
# Production: set to your Azure Database for PostgreSQL connection string.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aiapply

# Optional. Defaults to "local". Set to "azure-key-vault" once that backend exists.
SECRETS_BACKEND=local
