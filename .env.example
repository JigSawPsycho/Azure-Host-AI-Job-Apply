# Copy to .env and fill in. Loaded by main.py via python-dotenv.

# Required in production. Optional locally — auto-generated and persisted to
# data/.dev-secrets.json on first boot when SECRETS_BACKEND != azure-key-vault.
# Generate manually with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Required in production. Optional locally — auto-generated alongside
# SESSION_SECRET. Fernet key (urlsafe-base64, 32 bytes). Generate manually with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_MASTER_KEY=

# Optional: where to write the local-dev secret store sidecar
SECRETS_LOCAL_PATH=data/secrets.json

# Optional: absolute path to the Claude Code CLI used by `system` billing
# mode in local dev. Defaults to `claude` on PATH. Set this if `claude` isn't
# on PATH (e.g. `C:\Users\you\.local\bin\claude.exe`).
# CLAUDE_CLI_PATH=

# --- GitHub OAuth ---
# Register at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# --- Google OAuth (optional — leave blank if you only want GitHub sign-in) ---
# Register at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/auth/google/callback
# Required scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Email/password (Microsoft Entra, auth code flow) ---
# App registration in Entra. Required:
#   Authentication → Web platform with redirect URI matching MS_REDIRECT_URI
#   ID tokens enabled
#   Client secret created (use the Value, not the Secret ID)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/auth/ms/callback
# Optional. Default https://login.microsoftonline.com/{MS_TENANT_ID}.
# For Entra External ID / B2C set the full authority, e.g.
#   https://yourtenant.ciamlogin.com/{tenant_id}
# MS_AUTHORITY=

# Optional. Defaults to a local SQLite file under ./data/.
# Production: set to your Azure Database for PostgreSQL connection string.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aiapply

# Optional. Defaults to "local". Set to "azure-key-vault" in production.
SECRETS_BACKEND=local

# Required when SECRETS_BACKEND=azure-key-vault
# AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net

# Production hardening — set both on Azure App Service.
# SESSION_HTTPS_ONLY=1     # secure-cookie flag
# TRUST_PROXY_HEADERS=1    # honour X-Forwarded-Proto from App Service

# --- Billing (Stripe + host-paid Anthropic) ---
# When a user is in billing_mode="tokens" (the default), generations are
# billed against their token balance and call out to Anthropic with the
# host's API key below. Users who flip to billing_mode="byok" use their
# own anthropic_key and pay no tokens.
ANTHROPIC_HOST_API_KEY=

# Stripe keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from https://dashboard.stripe.com/webhooks
# (after registering an endpoint pointing at /api/billing/webhook).
STRIPE_WEBHOOK_SECRET=
# Where Stripe Checkout redirects after success/cancel. Defaults below
# work for local dev; set the public URL in production.
# STRIPE_SUCCESS_URL=http://localhost:8000/settings.html?billing=success
# STRIPE_CANCEL_URL=http://localhost:8000/settings.html?billing=cancelled
